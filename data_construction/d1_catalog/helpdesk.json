{
  "tools": [
    {
      "name": "helpdesk_list_tickets",
      "description": "List helpdesk tickets",
      "input_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Filter by status: open, closed, all"
          },
          "priority": {
            "type": "string",
            "description": "Filter by priority: high, medium, low"
          },
          "category": {
            "type": "string",
            "description": "Filter by category"
          }
        },
        "required": []
      }
    },
    {
      "name": "helpdesk_get_ticket",
      "description": "Get detailed information for a single ticket",
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "description": "Ticket ID"
          }
        },
        "required": [
          "ticket_id"
        ]
      }
    },
    {
      "name": "helpdesk_update_ticket",
      "description": "更新工单（优先级、标签、分类）",
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "description": "工单ID"
          },
          "priority": {
            "type": "string",
            "description": "优先级"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "标签列表"
          },
          "category": {
            "type": "string",
            "description": "工单分类"
          }
        },
        "required": [
          "ticket_id"
        ]
      }
    },
    {
      "name": "helpdesk_close_ticket",
      "description": "关闭工单",
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "description": "工单ID"
          },
          "resolution": {
            "type": "string",
            "description": "解决说明"
          }
        },
        "required": [
          "ticket_id",
          "resolution"
        ]
      }
    }
  ],
  "endpoints": [
    {
      "tool_name": "helpdesk_list_tickets",
      "url": "http://localhost:9107/helpdesk/tickets",
      "method": "POST"
    },
    {
      "tool_name": "helpdesk_get_ticket",
      "url": "http://localhost:9107/helpdesk/tickets/get",
      "method": "POST"
    },
    {
      "tool_name": "helpdesk_update_ticket",
      "url": "http://localhost:9107/helpdesk/tickets/update",
      "method": "POST"
    },
    {
      "tool_name": "helpdesk_close_ticket",
      "url": "http://localhost:9107/helpdesk/tickets/close",
      "method": "POST"
    }
  ]
}