  "changes": [
    "Use explicit external checkout paths and selected filesystem/email managers, with no private checkout defaults or sibling symlinks.",
    "Parse literal notifications without running stage seeding on the host; import trusted source modules only.",
    "Reject unsupported backends, dynamic notifications, invalid rubrics, escaping paths and symlink assets; generate atomically without overwrite.",
    "Preserve both initial assets and later inject resources; install sqlite3 used by source stage updates.",
    "Wait for IMAP/SMTP greetings and propagate seeding command/email failures.",
    "Remove seed/checker source from the agent workspace after stage initialization; shared verification is not tamper-proof.",
    "Preserve per-stage weighted checkers; fail invalid task/runtime verification without fabricated zero rewards.",
    "Make Harbor mean/final aggregation explicit; retain extra final agent step as a documented adaptation.",
    "Remove placeholder oracle generation and experimental service mocks; accept optional external real oracle scripts.",
    "Retain upstream license, attribution and file hashes; document Harbor session resume and multi-step export boundary."
  ],
  "excluded": [
    "ClawMark task datasets, example tasks, training tasks, assets and injected files from the archive (supplied by an external checkout instead).",
    "Oracle solutions, generated Harbor tasks, experimental Notion/Sheets backends, diagnostics and development logs.",
    "Cluster paths, launch scripts, private endpoints and credentials."
  ],
